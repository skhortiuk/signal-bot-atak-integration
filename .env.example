# Copy to .env and fill in. Only SIGNAL_ACCOUNT is required.

# The bot's own Signal number in E.164 format (the account signal-cli is linked to).
SIGNAL_ACCOUNT=+380501234567

# host:port the signal-cli HTTP daemon listens on (must match --http).
SIGNAL_HTTP=127.0.0.1:8080

# Which chat backend to run (registered in messaging/factory.py). Only "signal"
# ships today; the seam is here so another platform is a drop-in.
MESSAGING_PLATFORM=signal

# Which output format to emit (registered in output/factory.py). Only "cot" ships.
OUTPUT_SINK=cot

# Where CoT events go. Pick ONE:
#   log://stdout            print the XML (protocol proof / CI)
#   tcp://127.0.0.1:4242    the bundled cot_listener, or an iTAK/WinTAK TCP input
#   udp://239.2.3.1:6969    ATAK/iTAK SA multicast mesh (default; often needs no client config)
#   udp://<iphone_ip>:4242  UDP unicast straight to a device
COT_URL=udp://239.2.3.1:6969

# Comma-separated E.164 numbers allowed to command the bot.
# Empty = only the bot's own account (the Note-to-Self setup). "*" = anyone.
ALLOWED_SENDERS=

# Treat the first number as longitude (the assignment's literal order).
# Default false = first number is latitude (physical reality).
LON_FIRST=false

# CoT affiliation letter: h hostile, f friendly, n neutral, u unknown. Default hostile.
AFFILIATION=h

# Minutes before a marker goes stale in the TAK client.
STALE_MINUTES=10

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
